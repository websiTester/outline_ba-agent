# ─────────────────────────────────────────────────────────────
# Caddy reverse proxy for Outline-BA (multi-workspace mode)
# Cloudflare proxy ON + Flexible SSL mode handles TLS termination.
# Caddy serves HTTP only — CF talks to VM on port 80.
# ─────────────────────────────────────────────────────────────

{
	# Disable auto HTTPS — Cloudflare terminates TLS, Caddy just routes HTTP
	auto_https off
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	}
}

# ───── FastAPI backend ─────
http://api.windyselfhost.online {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy fastapi:8000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}

# ───── Outline: root + ALL workspace subdomains ─────
# Note: Caddy v2's reverse_proxy automatically handles WebSocket upgrades.
# Do NOT manually set `header_up Connection` or `header_up Upgrade` — Caddy
# treats them as hop-by-hop headers and explicit forwarding prevents Caddy
# from switching into WS tunneling mode (request gets handled as plain HTTP,
# upstream returns 400 Bad Request).
http://windyselfhost.online, http://*.windyselfhost.online {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy outline:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		# Tell Outline that the original request was HTTPS (terminated by Cloudflare)
		header_up X-Forwarded-Proto https
	}

	log {
		output stdout
		format console
	}
}
